# BLE Mesh stack
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_BLE_MESH=y
CONFIG_BLE_MESH_NODE=y
CONFIG_BLE_MESH_PB_ADV=y
CONFIG_BLE_MESH_PB_GATT=y
CONFIG_BLE_MESH_GATT_PROXY_SERVER=y

# Message cache prevents duplicate relays
CONFIG_BLE_MESH_MSG_CACHE_SIZE=10

# Enough adv buffers for 20 nodes all advertising simultaneously
CONFIG_BLE_MESH_ADV_BUF_COUNT=60

# Standard BLE 4.2 features cover the whole mesh
CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y

# 1 kHz tick for clean 1 ms timeouts
CONFIG_FREERTOS_HZ=1000

# Serial output at 115200 for gateway.py
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
